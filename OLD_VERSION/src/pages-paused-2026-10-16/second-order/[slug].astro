---
import { getCollection, render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { baseSlugFromId, byLang, findTranslation } from "@/lib/content";

export async function getStaticPaths() {
  const allEntries = await getCollection("second-order");
  const entries = byLang(allEntries, "zh");
  return entries.map((entry) => ({
    params: { slug: baseSlugFromId(entry.id) },
    props: { entry, alternateUrl: findTranslation(allEntries, entry, "en", "second-order") }
  }));
}

const { entry, alternateUrl } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  summary={entry.data.summary}
  tags={entry.data.tags}
  headings={headings}
  lang="zh"
  alternateUrl={alternateUrl}
>
  <Content />
</ArticleLayout>
