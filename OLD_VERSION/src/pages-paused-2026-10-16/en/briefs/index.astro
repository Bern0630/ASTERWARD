---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "en";
const entries = sortByDateDesc(byLang(await getCollection("briefs"), lang));
---

<BaseLayout title="Research" description="Question-led cross-market research built from testable evidence." lang={lang} alternateUrl="/briefs/">
  <section class="site-shell archive-header">
    <p class="eyebrow">ASTERWARD Research</p>
    <h1>Research</h1>
    <p>Each piece answers one market question worth understanding. Nothing is published without sufficient evidence and a meaningful information edge.</p>
  </section>
  <section class="site-shell archive-list">
    {entries.length > 0 ? (
      <ContentList entries={entries} collectionPath="briefs" />
    ) : (
      <div class="article-body">
        <h2>No research is currently public</h2>
        <p>The previous library is fully preserved in a private archive. New research will appear here after topic selection and evidence review.</p>
      </div>
    )}
  </section>
</BaseLayout>
