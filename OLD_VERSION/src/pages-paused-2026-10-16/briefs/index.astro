---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "zh";
const entries = sortByDateDesc(byLang(await getCollection("briefs"), lang));
---

<BaseLayout title="研究" description="從市場問題出發，以跨市場證據形成可驗證的研究判斷。" lang={lang} alternateUrl="/en/briefs/">
  <section class="site-shell archive-header">
    <p class="eyebrow">ASTERWARD Research</p>
    <h1>研究</h1>
    <p>每篇研究只回答一個真正值得理解的市場問題。沒有足夠證據與資訊優勢時，不為發布而發布。</p>
  </section>
  <section class="site-shell archive-list">
    {entries.length > 0 ? (
      <ContentList entries={entries} collectionPath="briefs" />
    ) : (
      <div class="article-body">
        <h2>目前沒有公開研究</h2>
        <p>舊版內容已完整移入非公開封存區；新的研究將在完成選題與證據驗證後出現在這裡。</p>
      </div>
    )}
  </section>
</BaseLayout>
