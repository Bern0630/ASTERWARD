---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "zh";
const entries = sortByDateDesc(byLang(await getCollection("second-order"), lang));
---

<BaseLayout title="第二層效應" description="研究市場在第一層反應後，可能尚未充分定價 的第二層與第三層影響。" lang={lang} alternateUrl="/en/second-order/">
  <section class="site-shell archive-header">
    <p class="eyebrow">次級影響</p>
    <h1>第二層效應</h1>
    <p>研究市場在第一層反應後，可能尚未充分 price in 的第二層與第三層影響。</p>
  </section>
  <section class="site-shell archive-list">
    <ContentList entries={entries} collectionPath="second-order" />
  </section>
</BaseLayout>
