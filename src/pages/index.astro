---
import { getCollection } from "astro:content";
import Tags from "@/components/Tags.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_COPY } from "@/data/site";
import { byLang, entryUrl, formatDate, latest } from "@/lib/content";
import { withBase } from "@/lib/paths";

let lang: "zh" | "en" = "zh";
const research = latest(byLang(await getCollection("trends"), lang), 3);
const latestResearch = research[0];
const additionalResearch = research.slice(1);
const siteCopy = SITE_COPY[lang];
const copy = {
  latestResearch: "最新研究",
  research: "從一個真正想理解的問題開始",
  allResearch: "全部研究 →",
  readLatest: "閱讀最新研究 →",
  readFull: "閱讀全文 →",
  lede: "從真正值得理解的市場問題出發，以公開資料拆解技術、供應鏈、商業化進度與可能失效的條件。不為發布而發布，只留下能繼續驗證的判斷。"
};
---

<BaseLayout lang={lang} alternateUrl="/en/">
  <section class="site-shell hero">
    <div class="hero-intro">
      <p class="eyebrow">{siteCopy.eyebrow}</p>
      <h1 class="tagline">{siteCopy.tagline}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="topic-strip" aria-label={siteCopy.coverageLabel}>
        {siteCopy.topics.map((topic) => <span>{topic}</span>)}
      </div>
    </div>
    {
      latestResearch && (
        <article class="hero-feature">
          <div class="hero-feature-header">
            <p class="eyebrow">{copy.latestResearch}</p>
            <time datetime={latestResearch.data.date.toISOString()}>
              {formatDate(latestResearch.data.date, "short", lang)}
            </time>
          </div>
          <h2>
            <a href={withBase(entryUrl("trends", latestResearch.id, lang))}>
              {latestResearch.data.title}
            </a>
          </h2>
          <p>{latestResearch.data.summary}</p>
          <Tags tags={latestResearch.data.tags} />
          <a class="text-link" href={withBase(entryUrl("trends", latestResearch.id, lang))}>
            {copy.readLatest}
          </a>
        </article>
      )
    }
  </section>

  {
    additionalResearch.length > 0 ? (
      <section class="site-shell section">
        <div class="section-header">
          <div>
            <p class="eyebrow">{copy.latestResearch}</p>
            <h2>{copy.research}</h2>
          </div>
          <a class="text-link" href={withBase("/trends/")}>{copy.allResearch}</a>
        </div>
        <div class="brief-grid">
          {additionalResearch.map((entry) => (
            <article class="feature-brief">
              <time class="meta-line" datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date, "short", lang)}
              </time>
              <h3>
                <a href={withBase(entryUrl("trends", entry.id, lang))}>
                  {entry.data.title}
                </a>
              </h3>
              <p>{entry.data.summary}</p>
              <Tags tags={entry.data.tags} />
              <a class="text-link" href={withBase(entryUrl("trends", entry.id, lang))}>
                {copy.readFull}
              </a>
            </article>
          ))}
        </div>
      </section>
    ) : !latestResearch ? (
      <section class="site-shell section">
        <p class="eyebrow">研究狀態</p>
        <h2>目前沒有公開研究</h2>
        <p>新的研究會從感興趣的問題開始，經過證據驗證後才發布。</p>
      </section>
    ) : null
  }
</BaseLayout>
