---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "zh";
const entries = sortByDateDesc(byLang(await getCollection("trends"), lang));
---

<BaseLayout title="研究" description="從感興趣的問題開始，拆解技術、供應鏈、商業化進度與可能失效的條件。" lang={lang} alternateUrl="/en/trends/">
  <section class="site-shell archive-header">
    <p class="eyebrow">問題驅動</p>
    <h1>研究</h1>
    <p>從感興趣的問題開始，拆解技術、供應鏈、商業化進度與可能失效的條件。</p>
  </section>
  <section class="site-shell archive-list">
    <ContentList entries={entries} collectionPath="trends" />
  </section>
</BaseLayout>
