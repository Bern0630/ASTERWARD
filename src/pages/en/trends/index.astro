---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "en";
const entries = sortByDateDesc(byLang(await getCollection("trends"), lang));
---

<BaseLayout title="Research" description="Research that starts with a question worth pursuing and follows the evidence through technology, supply chains, commercialization, and the facts that could change the conclusion." lang={lang} alternateUrl="/trends/">
  <section class="site-shell archive-header">
    <p class="eyebrow">Question-led</p>
    <h1>Research</h1>
    <p>Each article starts with a question worth pursuing and follows the evidence through technology, supply chains, commercialization, and the facts that could change the conclusion.</p>
  </section>
  <section class="site-shell archive-list">
    <ContentList entries={entries} collectionPath="trends" />
  </section>
</BaseLayout>
