---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "en";
const entries = sortByDateDesc(byLang(await getCollection("trends"), lang));
---

<BaseLayout title="Research" description="Research that begins with an interesting question and tests the technology, supply chain, commercialization milestones, and invalidation conditions." lang={lang} alternateUrl="/trends/">
  <section class="site-shell archive-header">
    <p class="eyebrow">Question-led</p>
    <h1>Research</h1>
    <p>Research that begins with an interesting question and tests the technology, supply chain, commercialization milestones, and invalidation conditions.</p>
  </section>
  <section class="site-shell archive-list">
    <ContentList entries={entries} collectionPath="trends" />
  </section>
</BaseLayout>
