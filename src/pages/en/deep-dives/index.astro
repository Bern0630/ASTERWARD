---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byLang, sortByDateDesc } from "@/lib/content";

let lang: "zh" | "en" = "en";
const entries = sortByDateDesc(byLang(await getCollection("deep-dives"), lang));
---

<BaseLayout title="Deep Dives" description="Long-form research on markets, industries, financing structures and cross-market consequences." lang={lang} alternateUrl="/deep-dives/">
  <section class="site-shell archive-header">
    <p class="eyebrow">Deep Dives</p>
    <h1>Deep Dives</h1>
    <p>Long-form research on markets, industries, financing structures and cross-market consequences.</p>
  </section>
  <section class="site-shell archive-list">
    <ContentList entries={entries} collectionPath="deep-dives" />
  </section>
</BaseLayout>
