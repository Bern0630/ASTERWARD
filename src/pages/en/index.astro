---
import { getCollection } from "astro:content";
import Tags from "@/components/Tags.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE, SITE_COPY } from "@/data/site";
import { byLang, entryUrl, formatDate, latest } from "@/lib/content";
import { withBase } from "@/lib/paths";

let lang: "zh" | "en" = "en";
const briefs = latest(byLang(await getCollection("briefs"), lang), 3);
const latestBrief = briefs[0];
const siteCopy = SITE_COPY[lang];
const copy = {
  latestBrief: "Latest Brief",
  daily: "Daily intelligence for the United States, Taiwan, and Malaysia",
  allBriefs: "All briefs →",
  readLatest: "Read latest brief →",
  readFull: "Read full brief →",
  lede: "Daily market intelligence for the United States, Taiwan, and Malaysia, updated twice each weekday with explicit evidence and invalidation conditions."
};
---

<BaseLayout lang={lang} alternateUrl="/">
  <section class="site-shell hero">
    <div>
      <p class="eyebrow">{siteCopy.eyebrow}</p>
      <h1>{SITE.name}</h1>
    </div>
    <p class="tagline">{siteCopy.tagline}</p>
    <p class="lede">{copy.lede}</p>
    <div class="topic-strip" aria-label={siteCopy.coverageLabel}>
      {siteCopy.topics.map((topic) => <span>{topic}</span>)}
    </div>
    {
      latestBrief && (
        <a class="text-link" href={withBase(entryUrl("briefs", latestBrief.id, lang))}>
          {copy.readLatest}
        </a>
      )
    }
  </section>

  {
    latestBrief && (
      <section class="site-shell section">
        <div class="section-header">
          <div>
            <p class="eyebrow">{copy.latestBrief}</p>
            <h2>{copy.daily}</h2>
          </div>
          <a class="text-link" href={withBase("/en/briefs/")}>{copy.allBriefs}</a>
        </div>
        <div class="brief-grid">
          {briefs.map((brief, index) => (
            <article class:list={["feature-brief", { "is-latest": index === 0 }]}>
              <time class="meta-line" datetime={brief.data.date.toISOString()}>
                {formatDate(brief.data.date, "short", lang)}
              </time>
              <h3>
                <a href={withBase(entryUrl("briefs", brief.id, lang))}>
                  {brief.data.title}
                </a>
              </h3>
              <p>{brief.data.summary}</p>
              <Tags tags={brief.data.tags} />
              <a class="text-link" href={withBase(entryUrl("briefs", brief.id, lang))}>
                {copy.readFull}
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
