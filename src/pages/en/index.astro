---
import { getCollection } from "astro:content";
import Tags from "@/components/Tags.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_COPY } from "@/data/site";
import { byLang, entryUrl, formatDate, latest } from "@/lib/content";
import { withBase } from "@/lib/paths";

let lang: "zh" | "en" = "en";
const research = latest(byLang(await getCollection("trends"), lang), 3);
const latestResearch = research[0];
const siteCopy = SITE_COPY[lang];
const copy = {
  latestResearch: "Latest Research",
  research: "Starting with a question worth understanding",
  allResearch: "All research →",
  readLatest: "Read latest research →",
  readFull: "Read full research →",
  lede: "Research begins with a market question worth understanding, then uses public evidence to examine the technology, supply chain, commercialization milestones, and invalidation conditions. Nothing is published merely to fill a schedule."
};
---

<BaseLayout lang={lang} alternateUrl="/">
  <section class="site-shell hero">
    <p class="eyebrow">{siteCopy.eyebrow}</p>
    <p class="tagline">{siteCopy.tagline}</p>
    <p class="lede">{copy.lede}</p>
    <div class="topic-strip" aria-label={siteCopy.coverageLabel}>
      {siteCopy.topics.map((topic) => <span>{topic}</span>)}
    </div>
    {
      latestResearch && (
        <a class="text-link" href={withBase(entryUrl("trends", latestResearch.id, lang))}>
          {copy.readLatest}
        </a>
      )
    }
  </section>

  {
    latestResearch ? (
      <section class="site-shell section">
        <div class="section-header">
          <div>
            <p class="eyebrow">{copy.latestResearch}</p>
            <h2>{copy.research}</h2>
          </div>
          <a class="text-link" href={withBase("/en/trends/")}>{copy.allResearch}</a>
        </div>
        <div class="brief-grid">
          {research.map((entry, index) => (
            <article class:list={["feature-brief", { "is-latest": index === 0 }]}>
              <time class="meta-line" datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date, "short", lang)}
              </time>
              <h3>
                <a href={withBase(entryUrl("trends", entry.id, lang))}>
                  {entry.data.title}
                </a>
              </h3>
              <p>{entry.data.summary}</p>
              <Tags tags={entry.data.tags} />
              <a class="text-link" href={withBase(entryUrl("trends", entry.id, lang))}>
                {copy.readFull}
              </a>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <section class="site-shell section">
        <p class="eyebrow">Research status</p>
        <h2>No research is currently public</h2>
        <p>New research begins with a question worth investigating and is published only after the evidence has been tested.</p>
      </section>
    )
  }
</BaseLayout>
