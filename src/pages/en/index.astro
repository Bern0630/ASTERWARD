---
import { getCollection } from "astro:content";
import Tags from "@/components/Tags.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_COPY } from "@/data/site";
import { byLang, entryUrl, formatDate, latest } from "@/lib/content";
import { withBase } from "@/lib/paths";

let lang: "zh" | "en" = "en";
const briefs = latest(byLang(await getCollection("briefs"), lang), 3);
const latestBrief = briefs[0];
const siteCopy = SITE_COPY[lang];
const copy = {
  latestResearch: "Latest Research",
  research: "Question-led cross-market research",
  allResearch: "All research →",
  readLatest: "Read latest research →",
  readFull: "Read full research →",
  lede: "Research begins with a market question worth understanding, then uses prices and evidence from the United States, Taiwan, and Malaysia to build a testable view. Nothing is published merely to fill a schedule."
};
---

<BaseLayout lang={lang} alternateUrl="/">
  <section class="site-shell hero">
    <p class="eyebrow">{siteCopy.eyebrow}</p>
    <p class="tagline">{siteCopy.tagline}</p>
    <p class="lede">{copy.lede}</p>
    <div class="topic-strip" aria-label={siteCopy.coverageLabel}>
      {siteCopy.topics.map((topic) => <span>{topic}</span>)}
    </div>
    {
      latestBrief && (
        <a class="text-link" href={withBase(entryUrl("briefs", latestBrief.id, lang))}>
          {copy.readLatest}
        </a>
      )
    }
  </section>

  {
    latestBrief ? (
      <section class="site-shell section">
        <div class="section-header">
          <div>
            <p class="eyebrow">{copy.latestResearch}</p>
            <h2>{copy.research}</h2>
          </div>
          <a class="text-link" href={withBase("/en/briefs/")}>{copy.allResearch}</a>
        </div>
        <div class="brief-grid">
          {briefs.map((brief, index) => (
            <article class:list={["feature-brief", { "is-latest": index === 0 }]}>
              <time class="meta-line" datetime={brief.data.date.toISOString()}>
                {formatDate(brief.data.date, "short", lang)}
              </time>
              <h3>
                <a href={withBase(entryUrl("briefs", brief.id, lang))}>
                  {brief.data.title}
                </a>
              </h3>
              <p>{brief.data.summary}</p>
              <Tags tags={brief.data.tags} />
              <a class="text-link" href={withBase(entryUrl("briefs", brief.id, lang))}>
                {copy.readFull}
              </a>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <section class="site-shell section">
        <p class="eyebrow">Research status</p>
        <h2>No research is currently public</h2>
        <p>The previous library is fully archived. New research will be published only after an interesting question has been tested against the evidence.</p>
      </section>
    )
  }
</BaseLayout>
