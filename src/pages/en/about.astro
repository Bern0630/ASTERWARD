---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="SECURRENT is an independent market intelligence and research publication focused on forces beyond the first market reaction."
  lang="en"
  alternateUrl="/about/"
>
  <section class="site-shell archive-header">
    <p class="eyebrow">About</p>
    <h1>SECURRENT</h1>
    <p>
      SECURRENT is an independent market intelligence and research publication
      focused on the forces that move markets beyond the first reaction.
    </p>
  </section>

  <section class="article-grid">
    <div class="article-body">
      <p>
        Research focuses on macroeconomics, rates, credit, capital flows,
        industry fundamentals and cross-market transmission.
      </p>

      <h2>Primary markets</h2>
      <ul>
        <li>United States</li>
        <li>Taiwan</li>
        <li>Malaysia</li>
      </ul>

      <h2>Additional coverage</h2>
      <ul>
        <li>China</li>
        <li>Japan</li>
        <li>Europe</li>
        <li>Middle East</li>
        <li>Energy</li>
        <li>AI infrastructure</li>
        <li>Global credit</li>
      </ul>

      <h2>Research philosophy</h2>
      <blockquote>
        Fact → Expectation → Pricing → Transmission → Second-order effects
      </blockquote>

      <p>Independent research and market commentary. Not investment advice.</p>
    </div>
  </section>
</BaseLayout>
